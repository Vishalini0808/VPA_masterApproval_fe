<mvc:View
    controllerName="vpamasterapproval.controller.ModelMaster"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes">

    <Page id="page" showHeader="false">

        <content>

            <VBox
                id="modelmastercontainer"
                width="auto"
                class="sapUiMediumMargin">

                <!-- HEADER -->

                <HBox
                    id="hbox"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom">

                    <core:Icon
                        id="modelMasterIcon"
                        src="sap-icon://car-rental"
                        size="2rem"
                        class="sapUiSmallMarginEnd"/>

                    <VBox id="vbox">

                        <Title
                            id="modeltitle"
                            text="Model Master"
                            level="H2"/>

                        <Text
                            id="pendingCountText"
                            text="{pager>/total} records pending for approval"/>

                    </VBox>

                </HBox>


                <!-- SEARCH TOOLBAR -->

                <OverflowToolbar
                    id="modelmasterToolbar"
                    width="100%">

                    <SearchField
                        id="modelSearchField"
                        width="300px"
                        placeholder="Search by Model Code or Description..."
                        liveChange=".onSearch">

                        <layoutData>
                            <OverflowToolbarLayoutData
                                priority="NeverOverflow"
                                shrinkable="true"
                                minWidth="150px"/>
                        </layoutData>

                    </SearchField>

                    <Select
                        id="fieldFilterSelect"
                        width="170px"
                        selectedKey="all"
                        change=".onFieldFilterChange">

                        <items>
                            <core:Item id="allFieldsItem" key="all" text="All Fields"/>
                            <core:Item id="modelCodeItem" key="modelCode" text="Model Code"/>
                            <core:Item id="descriptionItem" key="modelDescription" text="Description"/>
                            <core:Item id="engineTypeItem" key="engineType" text="Engine Type"/>
                        </items>

                    </Select>

                    <ToolbarSpacer id="toolspacer"/>

                    <Button
                        id="refreshButton"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh">

                        <layoutData>
                            <OverflowToolbarLayoutData priority="NeverOverflow"/>
                        </layoutData>

                    </Button>

                </OverflowToolbar>


                <!-- MODEL TABLE (only SUBMITTED records are requested from the server) -->

                <t:Table
                    id="model"
                    width="100%"
                    selectionMode="None"
                    enableColumnReordering="true"
                    rowsUpdated=".onRowsUpdated"

                    rows="{
                        path: '/Models',
                        parameters: { $count: true },
                        filters: [
                            {
                                path: 'approvalStatus',
                                operator: 'EQ',
                                value1: 'SUBMITTED'
                            }
                        ]
                    }">

                    <t:rowMode>
                        <rowmodes:Fixed id="modelRowMode" rowCount="10"/>
                    </t:rowMode>

                    <t:columns>

                        <t:Column
                            id="rowNumberColumn"
                            width="4rem"
                            hAlign="End">
                            <Label id="rowNumberLabel" text="#"/>
                            <t:template>
                                <Text id="rowNumberText" text="" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="modelCodeColumn"
                            width="12rem"
                            sortProperty="modelCode"
                            filterProperty="modelCode">
                            <Label id="modelcode" text="Model Code"/>
                            <t:template>
                                <Text id="modelCodeText" text="{modelCode}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="modelDescriptionColumn"
                            width="14rem"
                            sortProperty="modelDescription"
                            filterProperty="modelDescription">
                            <Label id="modeldesc" text="Description"/>
                            <t:template>
                                <Text id="modelDescriptionText" text="{modelDescription}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="engineTypeColumn"
                            width="10rem"
                            sortProperty="engineType"
                            filterProperty="engineType">
                            <Label id="enginetype" text="Engine Type"/>
                            <t:template>
                                <Text id="engineTypeText" text="{engineType}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="ccWattColumn"
                            width="8rem"
                            hAlign="End"
                            sortProperty="ccWatt">
                            <Label id="cc" text="CC / Watt"/>
                            <t:template>
                                <Text id="ccWattText" text="{ccWatt}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="gstPercentColumn"
                            width="7rem"
                            hAlign="End"
                            sortProperty="gstPercent">
                            <Label id="gst" text="GST %"/>
                            <t:template>
                                <Text id="gstPercentText" text="{gstPercent}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="dealerMarginColumn"
                            width="10rem"
                            hAlign="End"
                            sortProperty="dealerMarginPercent">
                            <Label id="dealer" text="Dealer Margin %"/>
                            <t:template>
                                <Text id="dealerMarginText" text="{dealerMarginPercent}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="csdDiscountColumn"
                            width="10rem"
                            hAlign="End"
                            sortProperty="csdDiscountPercent">
                            <Label id="csd" text="CSD Discount %"/>
                            <t:template>
                                <Text id="csdDiscountText" text="{csdDiscountPercent}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="approvalStatusColumn"
                            width="10rem"
                            sortProperty="approvalStatus">
                            <Label id="approval" text="Approval Status"/>
                            <t:template>
                                <ObjectStatus
                                    id="approvalStatusObjectStatus"
                                    text="{path: 'approvalStatus', formatter: '.formatStatusText'}"
                                    state="{path: 'approvalStatus', formatter: '.formatStatusState'}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="actionsColumn"
                            width="17rem"
                            hAlign="Center">
                            <Label id="actionsLabel" text="Actions"/>
                            <t:template>
                                <HBox
                                    id="actionsBox"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <Button
                                        id="approveButton"
                                        text="Approve"
                                        icon="sap-icon://accept"
                                        type="Accept"
                                        class="sapUiTinyMarginEnd"
                                        enabled="{= ${approvalStatus} === 'SUBMITTED' }"
                                        press=".onApprove"/>

                                    <Button
                                        id="rejectButton"
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        type="Reject"
                                        enabled="{= ${approvalStatus} === 'SUBMITTED' }"
                                        press=".onReject"/>

                                </HBox>
                            </t:template>
                        </t:Column>

                    </t:columns>

                </t:Table>

            </VBox>

        </content>

    </Page>

</mvc:View>
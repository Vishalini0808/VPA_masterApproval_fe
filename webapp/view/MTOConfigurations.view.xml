<mvc:View
    controllerName="vpamasterapproval.controller.MTOConfigurations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes">

    <Page id="mtoPage" showHeader="false">

        <content>

            <VBox
                id="mtoContainer"
                width="auto"
                class="sapUiMediumMargin">

                <!-- HEADER -->

                <HBox
                    id="mtoHeader"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom">

                    <core:Icon
                        id="mtoIcon"
                        src="sap-icon://database"
                        size="2rem"
                        class="sapUiSmallMarginEnd"/>

                    <VBox id="mtoTitleBox">

                        <Title
                            id="mtoTitle"
                            text="MTO Configurations"
                            level="H2"/>

                        <Text
                            id="mtoCountText"
                            text="{pager>/total} records pending for approval"/>

                    </VBox>

                </HBox>


                <!-- SEARCH TOOLBAR -->

                <OverflowToolbar
                    id="mtoToolbar"
                    width="100%">

                    <SearchField
                        id="mtoSearchField"
                        width="300px"
                        placeholder="Search by MTO Model Code or Reference Model..."
                        liveChange=".onSearch">

                        <layoutData>
                            <OverflowToolbarLayoutData
                                priority="NeverOverflow"
                                shrinkable="true"
                                minWidth="150px"/>
                        </layoutData>

                    </SearchField>

                    <Select
                        id="mtoFieldFilterSelect"
                        width="200px"
                        selectedKey="all"
                        change=".onFieldFilterChange">

                        <items>
                            <core:Item id="mtoAllItem" key="all" text="All Fields"/>
                            <core:Item id="mtoCodeItem" key="mtoModelCode" text="MTO Model Code"/>
                            <core:Item id="mtoRefItem" key="referenceMTSModel_modelCode" text="Reference MTS Model"/>
                        </items>

                    </Select>

                    <ToolbarSpacer id="mtoSpacer"/>

                    <Button
                        id="mtoRefreshButton"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh">

                        <layoutData>
                            <OverflowToolbarLayoutData priority="NeverOverflow"/>
                        </layoutData>

                    </Button>

                </OverflowToolbar>


                <!-- MTO TABLE (only SUBMITTED records are requested from the server) -->

                <t:Table
                    id="mtoTable"
                    width="100%"
                    selectionMode="None"
                    enableColumnReordering="true"
                    rowsUpdated=".onRowsUpdated"

                    rows="{
                        path: '/MTOConfigurations',
                        parameters: { $count: true },
                        filters: [
                            {
                                path: 'approvalStatus',
                                operator: 'EQ',
                                value1: 'SUBMITTED'
                            }
                        ]
                    }">

                    <t:rowMode>
                        <rowmodes:Fixed id="mtoRowMode" rowCount="10"/>
                    </t:rowMode>

                    <t:columns>

                        <t:Column
                            id="mtoRowNumberColumn"
                            width="4rem"
                            hAlign="End">
                            <Label id="mtoRowNumberLabel" text="#"/>
                            <t:template>
                                <Text id="mtoRowNumberText" text="" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="mtoModelCodeColumn"
                            width="16rem"
                            sortProperty="mtoModelCode"
                            filterProperty="mtoModelCode">
                            <Label id="mtoModelCodeLabel" text="MTO Model Code"/>
                            <t:template>
                                <Text id="mtoModelCodeText" text="{mtoModelCode}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="mtoValidFromColumn"
                            width="10rem"
                            sortProperty="validFrom">
                            <Label id="mtoValidFromLabel" text="Valid From"/>
                            <t:template>
                                <Text
                                    id="mtoValidFromText"
                                    wrapping="false"
                                    text="{path: 'validFrom', type: 'sap.ui.model.odata.type.Date'}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="mtoRefModelColumn"
                            width="16rem"
                            sortProperty="referenceMTSModel_modelCode"
                            filterProperty="referenceMTSModel_modelCode">
                            <Label id="mtoRefModelLabel" text="Reference MTS Model"/>
                            <t:template>
                                <Text id="mtoRefModelText" text="{referenceMTSModel_modelCode}" wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="mtoStatusColumn"
                            width="10rem"
                            sortProperty="approvalStatus">
                            <Label id="mtoStatusLabel" text="Approval Status"/>
                            <t:template>
                                <ObjectStatus
                                    id="mtoStatusObjectStatus"
                                    text="{path: 'approvalStatus', formatter: '.formatStatusText'}"
                                    state="{path: 'approvalStatus', formatter: '.formatStatusState'}"/>
                            </t:template>
                        </t:Column>

                        <t:Column
                            id="mtoActionsColumn"
                            width="17rem"
                            hAlign="Center">
                            <Label id="mtoActionsLabel" text="Actions"/>
                            <t:template>
                                <HBox
                                    id="mtoActionsBox"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <Button
                                        id="mtoApproveButton"
                                        text="Approve"
                                        icon="sap-icon://accept"
                                        type="Accept"
                                        class="sapUiTinyMarginEnd"
                                        enabled="{= ${approvalStatus} === 'SUBMITTED' }"
                                        press=".onApprove"/>

                                    <Button
                                        id="mtoRejectButton"
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        type="Reject"
                                        enabled="{= ${approvalStatus} === 'SUBMITTED' }"
                                        press=".onReject"/>

                                </HBox>
                            </t:template>
                        </t:Column>

                    </t:columns>

                </t:Table>

            </VBox>

        </content>

    </Page>

</mvc:View>
<mvc:View
    controllerName="vpamasterapproval.controller.MTOConfigurations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:rowmodes="sap.ui.table.rowmodes">

    <Page id="mtoPage" showHeader="false">

        <content>

            <VBox id="mtoContainer" width="auto" class="sapUiMediumMargin">

                <!-- HEADER -->
                <HBox id="mtoHeader" alignItems="Center" class="sapUiSmallMarginBottom">

                    <core:Icon
                        id="mtoIcon"
                        src="sap-icon://database"
                        size="2rem"
                        class="sapUiSmallMarginEnd"/>

                    <VBox id="mtoTitleBox">
                        <Title id="mtoTitle" text="MTO Configurations" level="H2"/>
                        <Text id="mtoCountText" text="{tree>/count} records pending for approval"/>
                    </VBox>

                </HBox>

                <!-- SEARCH TOOLBAR -->
                <OverflowToolbar id="mtoToolbar" width="100%">

                    <SearchField
                        id="mtoSearchField"
                        width="200px"
                        placeholder="Search by MTO Model Code or Reference Model..."
                        liveChange=".onSearch">
                        <layoutData>
                            <OverflowToolbarLayoutData
                                priority="NeverOverflow"
                                shrinkable="true"
                                minWidth="150px"/>
                        </layoutData>
                    </SearchField>

                    <Select
                        id="mtoFieldFilterSelect"
                        width="200px"
                        selectedKey="all"
                        change=".onFieldFilterChange">
                        <items>
                            <core:Item id="mtoAllItem" key="all" text="All Fields"/>
                            <core:Item id="mtoCodeItem" key="mtoModelCode" text="MTO Model Code"/>
                            <core:Item id="mtoRefItem" key="referenceModel" text="Reference MTS Model"/>
                        </items>
                    </Select>

                    <ToolbarSpacer id="mtoSpacer"/>

                    <Button
                        id="mtoExpandAllButton"
                        text="Expand All"
                        icon="sap-icon://expand-all"
                        type="Transparent"
                        press=".onExpandAll"/>

                    <Button
                        id="mtoCollapseAllButton"
                        text="Collapse All"
                        icon="sap-icon://collapse-all"
                        type="Transparent"
                        press=".onCollapseAll"/>

                    <Button
                        id="mtoApproveSelectedButton"
                        text="Approve"
                        icon="sap-icon://accept"
                        type="Accept"
                        enabled="{= ${tree>/selectedCount} > 0 }"
                        press=".onApproveSelected"/>

                    <Button
                        id="mtoRejectSelectedButton"
                        text="Reject"
                        icon="sap-icon://decline"
                        type="Reject"
                        enabled="{= ${tree>/selectedCount} > 0 }"
                        press=".onRejectSelected"/>

                    <Button
                        id="mtoRefreshButton"
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh">
                        <layoutData>
                            <OverflowToolbarLayoutData priority="NeverOverflow"/>
                        </layoutData>
                    </Button>

                </OverflowToolbar>

                <!-- MTO TREE TABLE: MTO configuration (parent) -> parts (children) -->
                <t:TreeTable
                    id="mtoTreeTable"
                    width="100%"
                    selectionMode="MultiToggle"
                    selectionBehavior="RowSelector"
                    rowSelectionChange=".onSelectionChange"
                    enableColumnReordering="true"
                    rows="{
                        path: 'tree>/nodes',
                        parameters: {
                            arrayNames: ['children'],
                            numberOfExpandedLevels: 0
                        }
                    }">

                    <t:rowMode>
                        <rowmodes:Interactive id="mtoRowMode" rowCount="10"/>
                    </t:rowMode>

                    <t:columns>

                        <!-- tree column: MTO model code (parent) / part code (child) -->
                        <t:Column id="mtoNameColumn" width="20rem">
                            <Label id="mtoNameLabel" text="MTO Model Code / Part Code"/>
                            <t:template>
                                <Text
                                    id="mtoNameText"
                                    text="{tree>name}"
                                    wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoRefModelColumn" width="16rem">
                            <Label id="mtoRefModelLabel" text="Reference MTS Model"/>
                            <t:template>
                                <Text
                                    id="mtoRefModelText"
                                    text="{tree>referenceModel}"
                                    wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoValidFromColumn" width="10rem">
                            <Label id="mtoValidFromLabel" text="Valid From"/>
                            <t:template>
                                <Text
                                    id="mtoValidFromText"
                                    wrapping="false"
                                    text="{
                                        path: 'tree>validFrom',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { source: { pattern: 'yyyy-MM-dd' }, style: 'medium' }
                                    }"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoPartDescColumn" width="18rem">
                            <Label id="mtoPartDescLabel" text="Part Description"/>
                            <t:template>
                                <Text
                                    id="mtoPartDescText"
                                    text="{tree>description}"
                                    wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoQtyColumn" width="7rem" hAlign="End">
                            <Label id="mtoQtyLabel" text="Quantity"/>
                            <t:template>
                                <Text
                                    id="mtoQtyText"
                                    text="{tree>quantity}"
                                    wrapping="false"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoStatusColumn" width="10rem">
                            <Label id="mtoStatusLabel" text="Approval Status"/>
                            <t:template>
                                <ObjectStatus
                                    id="mtoStatusObjectStatus"
                                    visible="{= ${tree>type} === 'config' }"
                                    text="{path: 'tree>status', formatter: '.formatStatusText'}"
                                    state="{path: 'tree>status', formatter: '.formatStatusState'}"/>
                            </t:template>
                        </t:Column>

                        <t:Column id="mtoActionsColumn" width="17rem" hAlign="Center">
                            <Label id="mtoActionsLabel" text="Actions"/>
                            <t:template>
                                <HBox
                                    id="mtoActionsBox"
                                    alignItems="Center"
                                    justifyContent="Center"
                                    visible="{= ${tree>type} === 'config' }">

                                    <Button
                                        id="mtoApproveButton"
                                        text="Approve"
                                        icon="sap-icon://accept"
                                        type="Accept"
                                        class="sapUiTinyMarginEnd"
                                        enabled="{= ${tree>status} === 'SUBMITTED' }"
                                        press=".onApprove"/>

                                    <Button
                                        id="mtoRejectButton"
                                        text="Reject"
                                        icon="sap-icon://decline"
                                        type="Reject"
                                        enabled="{= ${tree>status} === 'SUBMITTED' }"
                                        press=".onReject"/>

                                </HBox>
                            </t:template>
                        </t:Column>

                    </t:columns>

                </t:TreeTable>

            </VBox>

        </content>

    </Page>

</mvc:View>